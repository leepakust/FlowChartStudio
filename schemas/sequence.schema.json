{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engineering-diagram/sequence.schema.json",
  "title": "Engineering Diagram Studio - Sequence",
  "type": "object",
  "required": ["actors", "messages"],
  "properties": {
    "title": {"type": "string"},
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string"},
          "note": {"type": "string"},
          "dashed": {"type": "boolean"},
          "async": {"type": "boolean"},
          "style": {"type": "string"}
        },
        "anyOf": [
          {"required": ["note"]},
          {"required": ["from", "to"]}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
