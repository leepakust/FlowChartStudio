  ],
  "edges": [
    [
      "init",
      "idle"
    ],
    [
      "idle",
      "run",
      "start"
    ],
    [
      "run",
      "run",
      "tick",
      "self-right"
    ],
    [
      "run",
      "fault",
      "fault"
    ],
    [
      "fault",
      "idle",
      "reset",
